parameters:
    level: 6
    paths:
        - plugin/wla-inmo/src/Core/Requirements.php
        - plugin/wla-inmo/src/Access/Capabilities.php
        - plugin/wla-inmo/src/Properties/Capabilities.php
        - plugin/wla-inmo/src/Taxonomies/Capabilities.php
        - plugin/wla-inmo/src/Import
        - plugin/wla-inmo/src/Frontend
    bootstrapFiles:
        - tests/phpstan/wordpress-import-stubs.php
        - tests/phpstan/wordpress-frontend-stubs.php
    ignoreErrors:
        -
            message: '#Strict comparison using === between non-empty-array<mixed, mixed> and array\{\} will always evaluate to false\.#'
            path: plugin/wla-inmo/src/Import/RowExecutor.php
            count: 1
        -
            message: '#Strict comparison using === between non-empty-array<mixed, mixed> and array\{\} will always evaluate to false\.#'
            path: plugin/wla-inmo/src/Import/WordPressPropertyWriter.php
            count: 1
    reportUnmatchedIgnoredErrors: true
