{
  "name": "wla/inmo",
  "description": "Motor inmobiliario ligero y desacoplado para WordPress.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "WLA\\Inmo\\": "src/"
    }
